# 复制为 .env.local 后填入真实值。.env.local 已 gitignore，永不提交。
# ⚠️ 会话中这些凭据已明文暴露，MVP 跑起来后建议轮换。

# 微信小程序
WX_APPID=wxfb83ad53ee194fe3
WX_APPSECRET=__FILL_ME__
WX_SUBSCRIBE_EVENT_TEMPLATE_ID=__FILL_ME__
WX_EVENT_REMINDER_LEAD_MINUTES=1440
WX_SUBSCRIBE_MINIPROGRAM_STATE=trial
# 真机体验版验证完成后填；用于 pnpm production:readiness 把手验项从 manual 变成 pass
WECHAT_TRUE_DEVICE_VERIFIED_AT=
WECHAT_TRUE_DEVICE_VERIFIED_USER_ID=
WECHAT_TRUE_DEVICE_TEST_REMINDER_SENT_AT=
# 代码上传私钥路径（miniprogram-ci 用），不要把 key 内容写进这里
WECHAT_PRIVATE_KEY_PATH=__FILL_ME_PRIVATE_KEY_PATH__
WX_UPLOAD_PRIVATE_KEY_PATH=__FILL_ME_PRIVATE_KEY_PATH__

# 轮换完成后用 pnpm secrets:rotation-record 写入；不填表示仍需轮换
WX_APPSECRET_ROTATED_AT=
WECHAT_PRIVATE_KEY_ROTATED_AT=
LLM_API_KEY_ROTATED_AT=
BACKOFFICE_ADMIN_TOKEN_ROTATED_AT=

# 微信支付 V3（不填则 PAYMENT_PROVIDER 默认 mock；填完先跑 pnpm wechatpay:check）
PAYMENT_PROVIDER=mock
WECHATPAY_MCHID=__FILL_ME__
WECHATPAY_MERCHANT_SERIAL_NO=__FILL_ME__
# 支持把换行写成 \n；只放 .env.local/FC 环境，不进 repo
WECHATPAY_MERCHANT_PRIVATE_KEY=__FILL_ME__
WECHATPAY_API_V3_KEY=__FILL_ME__
WECHATPAY_PLATFORM_CERT_PEM=__FILL_ME__
WECHATPAY_NOTIFY_URL=https://loopin.llmxy.xyz/api/payments/wechatpay/notify

# 后端
PORT=8787
# Studio 后台 IA 管理令牌；生产配置后后台 IA 路由会要求 x-loopin-admin-token
BACKOFFICE_ADMIN_TOKEN=__FILL_ME__
# 可选：生成后台 IA 邀请链接时使用；不填则返回当前 Studio 可拼接的相对链接
BACKOFFICE_STUDIO_URL=
# 本地用 SQLite；生产换 Supabase Postgres 连接串
DATABASE_URL="file:./dev.db"
# FC 部署专用，避免本地 SQLite DATABASE_URL 覆盖生产
FC_DATABASE_URL=__FILL_ME_POSTGRES_POOLER_URL__

# 域名（阿里云 FC 自定义域名，复用 llmxy.xyz）
PUBLIC_BASE_URL=https://loopin.llmxy.xyz
# Serverless Devs s.yaml 绑定 HTTPS 域名时用；从阿里云证书控制台复制
ALIYUN_FC_CERT_ID=__FILL_ME__

# AI 生成（AI Designer/物料）——OpenAI 兼容。当前用 MiMo（小米），实际值在 apps/api/.env
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
LLM_API_KEY=__FILL_ME__
LLM_MODEL=mimo-v2.5-pro
# 海外端点需代理（macOS Clash）
LLM_PROXY=http://127.0.0.1:7897
# FC 新加坡运行时通常留空，不走本机代理

# 选题雷达外部信号 JSON feed，多个 URL 用英文逗号或换行分隔；也支持 JSON 描述符。
# 纯 URL 支持数组、{ signals: [...] }、{ items: [...] }、{ data: [...] } 形状。
# 描述符支持 headers/auth/itemsPath/fieldMap，用于接合作方 API；header 值可写 env:XXX 从环境变量读取。
# 自举 feed：先把生产活动列表同步进 TopicSignal，等活动行/合作方 API 凭证到位后再追加或替换。
TOPIC_SIGNAL_FEED_URLS='{"feeds":[{"url":"https://loopin.llmxy.xyz/api/events","source":"loopin_production_events","label":"Loopin 生产活动","itemsPath":"events","fieldMap":{"externalId":"id","topic":"title","city":"city","heat":"minPriceCents","evidence":["venue","organizer"],"opportunity":"organizer","capturedAt":"startAt"}}]}'
