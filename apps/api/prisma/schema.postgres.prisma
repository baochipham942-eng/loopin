// Loopin production data model for Supabase Postgres.
// Local development keeps using schema.prisma (SQLite); deployment uses this schema plus migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizer {
  id          String   @id @default(cuid())
  name        String
  whitelisted Boolean  @default(false)
  hostProfile HostProfile?
  events      Event[]
  createdAt   DateTime @default(now())
}

model HostProfile {
  id          String    @id @default(cuid())
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  organizerId String    @unique
  bio         String?
  avatarUrl   String?
  links       String?   // JSON
}

model User {
  id            String         @id @default(cuid())
  openid        String?        @unique // 微信 openid
  phone         String?
  nickname      String?
  registrations Registration[]
  checkIns      CheckIn[]
}

model Event {
  id            String             @id @default(cuid())
  organizer     Organizer          @relation(fields: [organizerId], references: [id])
  organizerId   String
  title         String
  status        String             @default("draft") // draft/published/closed/completed/cancelled
  startAt       DateTime
  city          String
  venue         String?
  coverUrl      String?
  page          EventPage?
  ticketTypes   TicketType[]
  quotas        Quota[]
  forms         RegistrationForm[]
  registrations Registration[]
  budgetPlan    BudgetPlan?
  sponsorPlan   SponsorPlan?
  channels      Channel[]
  materials     Material[]
  agentTasks    AgentTask[]
  review        EventReview?
  createdAt     DateTime           @default(now())
}

model EventPage {
  id         String @id @default(cuid())
  event      Event  @relation(fields: [eventId], references: [id])
  eventId    String @unique
  template   String
  highlights String // JSON string[]
  agenda     String // JSON string[]
  faq        String // JSON {q,a}[]
}

model TicketType {
  id            String            @id @default(cuid())
  event         Event             @relation(fields: [eventId], references: [id])
  eventId       String
  name          String
  kind          String            // free/approval/paid
  priceCents    Int               @default(0)
  quotas        TicketTypeQuota[]
  registrations Registration[]
}

model Quota {
  id          String            @id @default(cuid())
  event       Event             @relation(fields: [eventId], references: [id])
  eventId     String
  name        String
  capacity    Int?              // null = 不限量
  used        Int               @default(0)
  ticketTypes TicketTypeQuota[]
  orders      Order[]
}

model TicketTypeQuota {
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  quota        Quota      @relation(fields: [quotaId], references: [id])
  quotaId      String

  @@id([ticketTypeId, quotaId])
}

model RegistrationForm {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  schema  String // JSON RegistrationFormSchema
}

model Registration {
  id           String     @id @default(cuid())
  event        Event      @relation(fields: [eventId], references: [id])
  eventId      String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  status       String     @default("draft")
  formValues   String     // JSON
  order        Order?
  checkIn      CheckIn?
  createdAt    DateTime   @default(now())
}

model Order {
  id                 String       @id @default(cuid())
  registration       Registration @relation(fields: [registrationId], references: [id])
  registrationId     String       @unique
  amountCents        Int
  seats              Int          @default(1)
  quota              Quota?       @relation(fields: [quotaId], references: [id])
  quotaId            String?
  lifecycle          String       @default("reserved") // reserved/completed/cancelled/abandoned
  payment_status     String       @default("unpaid")   // unpaid/paid
  refund_status      String       @default("none")     // none/partial/full
  refundedAmountCents Int         @default(0)
  reservedUntil      DateTime?
  pointInTimeData    String?
  mock               Boolean      @default(true)
  payment            Payment?
  createdAt          DateTime     @default(now())
}

model Payment {
  id       String    @id @default(cuid())
  order    Order     @relation(fields: [orderId], references: [id])
  orderId  String    @unique
  provider String    @default("mock")
  txnId    String?
  paidAt   DateTime?
}

model CheckIn {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id])
  registrationId String       @unique
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  checkedAt      DateTime     @default(now())
  by             String?
}

model Channel {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  name    String
  utm     String?
}

model Material {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  channel String
  content String
  version Int    @default(1)
}

model BudgetPlan {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  input   String
  result  String
}

model SponsorPlan {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  detail  String
}

model AgentTask {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  kind      String
  title     String
  detail    String?
  status    String   @default("suggested")
  highRisk  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EventReview {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  summary String
}
