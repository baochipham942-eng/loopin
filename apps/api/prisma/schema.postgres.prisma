// Loopin production data model for Supabase Postgres.
// Local development keeps using schema.prisma (SQLite); deployment uses this schema plus migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organizer {
  id          String   @id @default(cuid())
  name        String
  whitelisted Boolean  @default(false)
  hostProfile HostProfile?
  members     OrganizerMember[]
  events      Event[]
  createdAt   DateTime @default(now())
}

model OrganizerMember {
  id          String    @id @default(cuid())
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  organizerId String
  name        String
  email       String?
  role        String    @default("staff") // owner/admin/operator/checkin/viewer
  permissions String    // JSON string[]
  status      String    @default("active") // active/invited/disabled
  inviteTokenHash String? @unique
  inviteExpiresAt DateTime?
  acceptedAt  DateTime?
  accessTokenHash String? @unique
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizerId, email])
  @@index([organizerId, status])
}

model HostProfile {
  id          String    @id @default(cuid())
  organizer   Organizer @relation(fields: [organizerId], references: [id])
  organizerId String    @unique
  bio         String?
  avatarUrl   String?
  links       String?   // JSON
}

model User {
  id            String         @id @default(cuid())
  openid        String?        @unique // 微信 openid
  phone         String?
  nickname      String?
  registrations Registration[]
  checkIns      CheckIn[]
  notificationSubscriptions NotificationSubscription[]
  eventFeedbacks EventFeedback[]
  interestSubscriptions InterestSubscription[]
  attributionEvents AttributionEvent[]
}

model Event {
  id            String             @id @default(cuid())
  organizer     Organizer          @relation(fields: [organizerId], references: [id])
  organizerId   String
  title         String
  status        String             @default("draft") // draft/published/closed/completed/cancelled
  startAt       DateTime
  city          String
  venue         String?
  coverUrl      String?
  page          EventPage?
  ticketTypes   TicketType[]
  quotas        Quota[]
  forms         RegistrationForm[]
  registrations Registration[]
  waitlistEntries WaitlistEntry[]
  notificationSubscriptions NotificationSubscription[]
  budgetPlan    BudgetPlan?
  sponsorPlan   SponsorPlan?
  channels      Channel[]
  materials     Material[]
  resources     EventResource[]
  socialProfiles EventSocialProfile[]
  agentTasks    AgentTask[]
  review        EventReview?
  feedbacks     EventFeedback[]
  attributionEvents AttributionEvent[]
  createdAt     DateTime           @default(now())
}

model EventPage {
  id         String @id @default(cuid())
  event      Event  @relation(fields: [eventId], references: [id])
  eventId    String @unique
  template   String
  highlights String // JSON string[]
  agenda     String // JSON string[]
  faq        String // JSON {q,a}[]
}

model TicketType {
  id            String            @id @default(cuid())
  event         Event             @relation(fields: [eventId], references: [id])
  eventId       String
  name          String
  kind          String            // free/approval/paid
  priceCents    Int               @default(0)
  status        String            @default("active") // active/archived
  earlyBirdPriceCents Int?
  earlyBirdUntil      DateTime?
  inviteCode          String?
  quotas        TicketTypeQuota[]
  registrations Registration[]
}

model Quota {
  id          String            @id @default(cuid())
  event       Event             @relation(fields: [eventId], references: [id])
  eventId     String
  name        String
  capacity    Int?              // null = 不限量
  used        Int               @default(0)
  ticketTypes TicketTypeQuota[]
  orders      Order[]
  waitlistEntries WaitlistEntry[]
}

model TicketTypeQuota {
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  quota        Quota      @relation(fields: [quotaId], references: [id])
  quotaId      String

  @@id([ticketTypeId, quotaId])
}

model RegistrationForm {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  schema  String // JSON RegistrationFormSchema
}

model Registration {
  id           String     @id @default(cuid())
  event        Event      @relation(fields: [eventId], references: [id])
  eventId      String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId String
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  status       String     @default("draft")
  formValues   String     // JSON
  checkinToken String?    @unique
  tag          String?    // 现场重点标记：guest/vip/staff
  order        Order?
  checkIn      CheckIn?
  waitlistEntry WaitlistEntry?
  attributionEvents AttributionEvent[]
  createdAt    DateTime   @default(now())
}

model WaitlistEntry {
  id             String       @id @default(cuid())
  event          Event        @relation(fields: [eventId], references: [id])
  eventId        String
  registration   Registration @relation(fields: [registrationId], references: [id])
  registrationId String       @unique
  quota          Quota?       @relation(fields: [quotaId], references: [id])
  quotaId        String?
  position       Int
  offerToken     String       @unique
  status         String       @default("waiting") // waiting/offered/promoted/cancelled/expired
  offerExpiresAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([eventId, status, position])
}

model Order {
  id                 String       @id @default(cuid())
  registration       Registration @relation(fields: [registrationId], references: [id])
  registrationId     String       @unique
  amountCents        Int
  seats              Int          @default(1)
  quota              Quota?       @relation(fields: [quotaId], references: [id])
  quotaId            String?
  lifecycle          String       @default("reserved") // reserved/completed/cancelled/abandoned
  payment_status     String       @default("unpaid")   // unpaid/paid
  refund_status      String       @default("none")     // none/partial/full
  refundedAmountCents Int         @default(0)
  reservedUntil      DateTime?
  pointInTimeData    String?
  mock               Boolean      @default(true)
  payment            Payment?
  createdAt          DateTime     @default(now())
}

model Payment {
  id       String    @id @default(cuid())
  order    Order     @relation(fields: [orderId], references: [id])
  orderId  String    @unique
  provider String    @default("mock")
  txnId    String?
  paidAt   DateTime?
}

model CheckIn {
  id             String       @id @default(cuid())
  registration   Registration @relation(fields: [registrationId], references: [id])
  registrationId String       @unique
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  checkedAt      DateTime     @default(now())
  by             String?
}

model NotificationSubscription {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  type       String   @default("event_reminder")
  status     String   @default("accepted")
  reminderAt DateTime
  sentAt     DateTime?
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, eventId, type])
  @@index([type, status, reminderAt, sentAt])
  @@index([eventId, type, status])
}

model Channel {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  name    String
  utm     String?
}

model Material {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String
  channel String
  content String
  version Int    @default(1)
}

model EventResource {
  id          String   @id @default(cuid())
  event       Event    @relation(fields: [eventId], references: [id])
  eventId     String
  title       String
  type        String   @default("link")
  url         String
  description String?
  visibility  String   @default("attendee")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId, createdAt])
}

model EventSocialProfile {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  kind       String   @default("guest") // host/speaker/guest/attendee
  name       String
  headline   String
  bio        String?
  avatarUrl  String?
  tags       String   // JSON string[]
  links      String?  // JSON {label,url}[]
  visibility String   @default("public") // public/attendee/organizer
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([eventId, visibility, kind])
  @@index([kind, sortOrder])
}

model InterestSubscription {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  subscriptionKey String
  topic           String
  city            String?
  industry        String?
  format          String?
  sourceEventId   String?
  status          String   @default("active") // active/paused/cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, subscriptionKey])
  @@index([status, city, updatedAt])
}

model TopicSignal {
  id          String   @id @default(cuid())
  source      String
  externalId  String?
  label       String
  topic       String
  city        String?
  industries  String   // JSON string[]
  audiences   String   // JSON string[]
  formats     String   // JSON string[]
  heat        Int      @default(50)
  evidence    String
  opportunity String
  status      String   @default("active") // active/archived
  capturedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, updatedAt])
  @@index([source, status])
}

model BudgetPlan {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  input   String
  result  String
}

model SponsorPlan {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  detail  String
}

model AgentTask {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  kind      String
  title     String
  detail    String?
  status    String   @default("suggested")
  highRisk  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EventReview {
  id      String @id @default(cuid())
  event   Event  @relation(fields: [eventId], references: [id])
  eventId String @unique
  summary String
}

model EventFeedback {
  id             String   @id @default(cuid())
  event          Event    @relation(fields: [eventId], references: [id])
  eventId        String
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?
  registrationId String?
  rating         Int?
  valuable       String
  nextTopic      String
  roleInterest   String
  note           String?
  answers        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
  @@index([userId, createdAt])
}

model AttributionEvent {
  id             String        @id @default(cuid())
  type           String
  event          Event?        @relation(fields: [eventId], references: [id])
  eventId        String?
  registration   Registration? @relation(fields: [registrationId], references: [id])
  registrationId String?
  user           User?         @relation(fields: [userId], references: [id])
  userId         String?
  source         String?
  channel        String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  path           String?
  metadata       String?
  createdAt      DateTime      @default(now())

  @@index([eventId, type, createdAt])
  @@index([registrationId, createdAt])
  @@index([userId, createdAt])
  @@index([utmSource, createdAt])
  @@index([channel, createdAt])
}
