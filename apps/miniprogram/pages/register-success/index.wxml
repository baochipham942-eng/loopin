<view class="container center">
  <text class="ok">✅</text>
  <view class="status">{{statusText}}</view>
  <view class="muted tips">可在「我的活动」查看报名状态、活动二维码与提醒</view>
  <button wx:if="{{notifyReady}}" class="btn-secondary notify" bindtap="subscribeReminder" loading="{{notifySubscribing}}">开启活动提醒</button>
  <view wx:if="{{notifyText}}" class="muted notify-text">{{notifyText}}</view>
  <button class="btn-primary back" bindtap="goMy">查看我的活动</button>
  <button class="btn-link" bindtap="backHome">返回活动</button>
</view>
