<view wx:if="{{loading}}" class="container"><view class="muted">加载中…</view></view>

<view wx:else class="container">
  <view class="title">填写报名信息</view>
  <view class="muted sub">首次填写后，下次参加同主办方活动可一键复用</view>

  <block wx:for="{{schema.fields}}" wx:key="key">
    <view class="field">
      <text class="label">{{item.label}}{{item.required ? ' *' : ''}}</text>

      <input wx:if="{{item.isText}}" class="ipt" data-key="{{item.key}}"
        bindinput="onInput" placeholder="请输入{{item.label}}" placeholder-class="ph" />

      <input wx:elif="{{item.isPhone}}" class="ipt" type="number" data-key="{{item.key}}"
        bindinput="onInput" placeholder="请输入手机号" placeholder-class="ph" />

      <input wx:elif="{{item.isNumber}}" class="ipt" type="number" data-key="{{item.key}}"
        bindinput="onInput" placeholder="请输入{{item.label}}" placeholder-class="ph" />

      <picker wx:elif="{{item.isSingle}}" range="{{item.options}}" range-key="label"
        data-key="{{item.key}}" bindchange="onPick">
        <view class="ipt picker">{{labels[item.key] || '请选择'}}</view>
      </picker>

      <view wx:elif="{{item.isMulti}}" class="chips">
        <text wx:for="{{item.options}}" wx:for-item="opt" wx:key="value"
          class="chip {{values[item.key] && values[item.key].indexOf(opt.value) >= 0 ? 'chip-on' : ''}}"
          data-key="{{item.key}}" data-value="{{opt.value}}" bindtap="onToggle">{{opt.label}}</text>
      </view>
    </view>
  </block>

  <button class="btn-primary submit" bindtap="submit" loading="{{submitting}}">提交报名</button>
</view>
