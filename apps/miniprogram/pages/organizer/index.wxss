@import "../events/index.wxss";

.host-head {
  margin-top: 24rpx;
  padding: 36rpx 28rpx;
  border: 1rpx solid #2b3050;
  border-radius: 22rpx;
  background: linear-gradient(160deg, #1a1d36, #12152400);
  text-align: center;
}
.host-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin: 0 auto 18rpx;
  display: block;
}
.host-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #24305a, #122635);
  color: #00d2ff;
  font-size: 56rpx;
  font-weight: 800;
}
.host-name {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}
.host-bio {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.host-links {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}
.host-link-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #2f3455;
  background: #16182a;
  color: #00d2ff;
  font-size: 24rpx;
}
.section-title {
  margin: 40rpx 0 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}
