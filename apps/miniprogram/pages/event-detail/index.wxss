.cover {
  height: 320rpx; border-radius: 24rpx; margin-bottom: 28rpx;
  background: radial-gradient(400rpx 200rpx at 70% 0%, #2a2150, #181a2c);
  display: flex; align-items: center; justify-content: center;
}
.cover-emoji { font-size: 120rpx; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.meta { font-size: 26rpx; margin-top: 12rpx; }
.price-row { display: flex; justify-content: space-between; align-items: baseline; margin: 24rpx 0; }
.price { font-size: 40rpx; font-weight: 700; color: #00d2ff; }
.section-title { font-size: 30rpx; font-weight: 600; margin: 28rpx 0 14rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 999rpx; background: #ffffff10; color: #9aa0c4; }
.highlight { font-size: 28rpx; line-height: 1.9; }
.footbar { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: #0e0f1a; }
