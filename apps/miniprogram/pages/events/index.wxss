.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 18rpx;
}
.eyebrow {
  color: #00d2ff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0;
}
.title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}
.sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
}
.icon-btn {
  width: 132rpx;
  max-width: 132rpx;
  flex: 0 0 132rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 1rpx solid #2f3455;
  background: #16182a;
  color: #eef0ff;
  font-size: 26rpx;
  line-height: 64rpx;
}
.icon-btn::after { border: none; }
.loading {
  margin-top: 56rpx;
  font-size: 26rpx;
}
.list {
  margin-top: 34rpx;
}
.event-card {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #2b3050;
  border-radius: 18rpx;
  background: #15172a;
}
.date-tile {
  flex: 0 0 154rpx;
  min-height: 154rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #24305a, #122635);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.date-main {
  width: 112rpx;
  text-align: center;
  color: #eef0ff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
}
.date-time {
  margin-top: 10rpx;
  color: #00d2ff;
  font-size: 24rpx;
  font-weight: 700;
}
.card-body {
  flex: 1;
  min-width: 0;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}
.card-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.meta-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.price {
  color: #00d2ff;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}
.organizer {
  min-width: 0;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.empty {
  padding-top: 160rpx;
  text-align: center;
}
.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}
.empty-sub {
  font-size: 26rpx;
}
