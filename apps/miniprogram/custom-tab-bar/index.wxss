.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 99;
  min-height: 112rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  border: 1rpx solid #2b3050;
  border-radius: 30rpx;
  background: rgba(18, 20, 36, 0.96);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.32);
}
.tab-item {
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 22rpx;
  color: #9aa0c4;
}
.tab-item.active {
  color: #eef0ff;
  background: linear-gradient(135deg, rgba(108, 92, 231, 0.34), rgba(0, 210, 255, 0.18));
}
.tab-icon {
  width: 42rpx;
  height: 42rpx;
  position: relative;
  box-sizing: border-box;
  color: currentColor;
}
.tab-icon.events {
  border: 3rpx solid currentColor;
  border-radius: 10rpx;
  padding: 10rpx 6rpx 6rpx;
}
.calendar-top {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5rpx;
}
.calendar-grid view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 3rpx;
  background: currentColor;
  opacity: 0.72;
}
.tab-icon.my {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.person-head {
  width: 17rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-radius: 999rpx;
}
.person-body {
  width: 30rpx;
  height: 16rpx;
  margin-top: 3rpx;
  border: 3rpx solid currentColor;
  border-top-left-radius: 999rpx;
  border-top-right-radius: 999rpx;
  border-bottom: none;
}
.tab-text {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}
